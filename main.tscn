[sub_resource type="GDScript" id="GDScript_MAIN"]
script/source = "extends Node3D

func _ready():
	print("🌌 UNIVERSAL BEING - UNIFIED GAME INITIALIZING...")
	
	# Initialize all integrated systems
	setup_game_world()
	setup_ui_hints()
	setup_input_handling()
	connect_all_systems()

func setup_game_world():
	# Ensure all Universal Beings are properly connected
	var player = get_node_or_null('Player')
	var cursor = get_node_or_null('Cursor') 
	var console = get_node_or_null('Console')
	
	# Connect player to cursor for inspection
	if player and cursor and cursor.has_method('set_player_reference'):
		cursor.set_player_reference(player)

func connect_all_systems():
	# Connect Universal Being Action System
	var action_system = get_node_or_null('SimpleActionSystem')
	if action_system:
		print("🎭 Action System connected")
	
	# Connect Notepad 3D Astral
	var notepad_3d = get_node_or_null('Notepad3DAstral') 
	if notepad_3d:
		print("📝 Notepad 3D Programming connected")
		# Connect notepad signals to main system
		if notepad_3d.has_signal("code_executed"):
			notepad_3d.code_executed.connect(_on_code_executed)
		if notepad_3d.has_signal("ai_suggestion_given"):
			notepad_3d.ai_suggestion_given.connect(_on_ai_suggestion)
		if notepad_3d.has_signal("timeline_created"):
			notepad_3d.timeline_created.connect(_on_timeline_created)
	
	print("✨ ALL SYSTEMS CONNECTED - UNIFIED UNIVERSAL BEING READY!")

func setup_ui_hints():
	# Create game instructions UI
	var ui_layer = CanvasLayer.new()
	ui_layer.layer = 50
	add_child(ui_layer)
	
	var hints = Label.new()
	hints.text = '🌌 UNIVERSAL BEING UNIFIED GAME 🌌\nH: Action Demo | F: Tree Fruit | 1-6: Transform Beings\nN: Notepad 3D Mode | Console: ~ | E: Execute Code\nA: AI Help | C: Create 3D Code Block | T: Save Timeline'
	hints.position = Vector2(10, 10)
	hints.add_theme_color_override('font_color', Color.WHITE)
	hints.add_theme_color_override('font_shadow_color', Color.BLACK)
	hints.add_theme_constant_override('shadow_offset_x', 2)
	hints.add_theme_constant_override('shadow_offset_y', 2)
	ui_layer.add_child(hints)

func setup_input_handling():
	# Enable console toggle
	set_process_input(true)

func _input(event):
	if event.is_action_pressed('open_console'):
		var console = get_node_or_null('Console')
		if console and console.has_method('toggle_console_visibility'):
			console.toggle_console_visibility()
	
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_N:  # Toggle Notepad 3D mode
				_toggle_notepad_3d_mode()
			KEY_H:  # Action demo
				_trigger_action_demo()

func _toggle_notepad_3d_mode():
	var notepad_3d = get_node_or_null('Notepad3DAstral')
	if notepad_3d:
		notepad_3d.visible = !notepad_3d.visible
		print("📝 Notepad 3D:", "ON" if notepad_3d.visible else "OFF")

func _trigger_action_demo():
	var action_system = get_node_or_null('SimpleActionSystem')
	if action_system and action_system.has_method('demonstrate_action_cycle'):
		action_system.demonstrate_action_cycle()

func _on_code_executed(result: String):
	print("🚀 Code executed in 3D space:", result)

func _on_ai_suggestion(suggestion: String):
	print("🤖 AI suggested:", suggestion)

func _on_timeline_created(timeline_id: String):
	print("💾 Timeline created:", timeline_id)
"

