[sub_resource type="GDScript" id="GDScript_ultimate_camera"]
script/source = "# ULTIMATE GALAXY CAMERA SYSTEM
extends Camera3D
class_name UltimateGalaxyCamera

@export var galaxy_fov: float = 90.0
@export var warp_vision_enabled: bool = true
@export var consciousness_overlay: bool = true

var base_fov: float = 75.0
var warp_factor: float = 1.0

func _ready():
	fov = galaxy_fov
	print('📹 ULTIMATE GALAXY CAMERA: CONSCIOUSNESS VISION ACTIVATED!')

func apply_warp_vision(factor: float):
	warp_factor = factor
	if warp_vision_enabled:
		fov = base_fov + (factor * 20.0)  # Expand FOV during warp
		
func enable_consciousness_overlay():
	if consciousness_overlay:
		print('👁️ CONSCIOUSNESS OVERLAY: SEEING BEYOND REALITY!')
"

