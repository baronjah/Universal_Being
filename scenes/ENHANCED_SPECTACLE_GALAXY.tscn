[sub_resource type="GDScript" id="GDScript_enhanced_camera"]
script/source = "# ENHANCED GALAXY CAMERA WITH SPECTACLE OPTIMIZATION
extends Camera3D
class_name EnhancedSpectacleCamera

@export var galaxy_fov: float = 100.0
@export var spectacle_mode: bool = true
@export var consciousness_tracking: bool = true
@export var dynamic_effects: bool = true

var base_fov: float = 75.0
var spectacle_intensity: float = 1.0

func _ready():
	fov = galaxy_fov
	print('📹 ENHANCED SPECTACLE CAMERA: MAXIMUM VISUAL IMPACT ACTIVATED!')
	
	if spectacle_mode:
		setup_spectacle_effects()

func setup_spectacle_effects():
	# Enhanced visual effects for maximum spectacle
	var env = get_viewport().get_world_3d().environment
	if env:
		env.glow_enabled = true
		env.glow_intensity = 2.5
		env.glow_strength = 1.8
		env.glow_bloom = 0.5
		
		# Enhanced fog for atmosphere
		env.fog_enabled = true
		env.fog_density = 0.008
		env.fog_depth_curve = 1.8
		
	print('🌟 SPECTACLE EFFECTS: MAXIMUM VISUAL MAGNIFICENCE!')

func apply_consciousness_vision(consciousness_level: float):
	if consciousness_tracking:
		spectacle_intensity = 1.0 + consciousness_level * 0.3
		fov = base_fov + (consciousness_level * 15.0)
		
func enable_dynamic_spectacle():
	if dynamic_effects:
		var tween = create_tween()
		tween.set_loops()
		tween.tween_method(update_spectacle_fov, galaxy_fov, galaxy_fov + 20.0, 3.0)
		tween.tween_method(update_spectacle_fov, galaxy_fov + 20.0, galaxy_fov, 3.0)
		
func update_spectacle_fov(new_fov: float):
	fov = new_fov * spectacle_intensity
"

