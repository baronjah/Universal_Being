[sub_resource type="GDScript" id="ultimate_spectacular_camera"]
script/source = "# ULTIMATE SPECTACULAR CAMERA - 8-AGENT ENHANCED
extends Camera3D
class_name UltimateSpectacularCamera

@export var spectacular_fov: float = 130.0
@export var consciousness_tracking: bool = true
@export var dynamic_spectacle: bool = true
@export var transcendent_mode: bool = true

var base_fov: float = 90.0
var spectacle_intensity: float = 2.5
var consciousness_multiplier: float = 1.0

func _ready():
	fov = spectacular_fov
	print('📹 ULTIMATE SPECTACULAR CAMERA: 8-AGENT ENHANCEMENT ACTIVE!')
	
	if transcendent_mode:
		setup_transcendent_vision()

func setup_transcendent_vision():
	# Maximum spectacle effects
	var env = get_viewport().get_world_3d().environment
	if env:
		env.glow_enabled = true
		env.glow_intensity = 3.5
		env.glow_strength = 2.2
		env.glow_bloom = 0.7
		
		env.fog_enabled = true
		env.fog_density = 0.006
		env.fog_depth_curve = 1.5
		
	print('✨ TRANSCENDENT VISION: REALITY-BENDING EFFECTS ACTIVE!')

func apply_consciousness_vision(level: float):
	if consciousness_tracking:
		consciousness_multiplier = 1.0 + level * 0.5
		spectacle_intensity = 2.5 * consciousness_multiplier
		fov = base_fov + (level * 25.0)

func create_spectacular_reveal():
	print('🌟 CREATING SPECTACULAR CAMERA REVEAL!')
	var tween = create_tween()
	tween.set_parallel(true)
	tween.tween_property(self, 'fov', spectacular_fov + 30.0, 2.0)
	tween.tween_property(self, 'fov', spectacular_fov, 3.0).set_delay(2.0)

func enable_dynamic_spectacle():
	if dynamic_spectacle:
		var tween = create_tween()
		tween.set_loops()
		tween.tween_method(update_dynamic_fov, spectacular_fov, spectacular_fov + 25.0, 4.0)
		tween.tween_method(update_dynamic_fov, spectacular_fov + 25.0, spectacular_fov, 4.0)

func update_dynamic_fov(new_fov: float):
	fov = new_fov * spectacle_intensity * 0.5 + new_fov * 0.5

func set_spectacle_intensity(intensity: float):
	spectacle_intensity = intensity
	apply_consciousness_vision(consciousness_multiplier)

func flow_transition_effect(new_state):
	print('🌊 Camera flow transition: %s' % new_state)
	var transition_tween = create_tween()
	transition_tween.tween_property(self, 'fov', spectacular_fov + 20.0, 0.5)
	transition_tween.tween_property(self, 'fov', spectacular_fov, 1.0)
"

