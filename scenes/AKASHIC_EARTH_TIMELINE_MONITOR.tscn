[sub_resource type="GDScript" id="earth_timeline_camera"]
script/source = "extends Camera3D

@export var orbit_speed: float = 1.0
@export var zoom_speed: float = 5.0
@export var min_distance: float = 15.0
@export var max_distance: float = 100.0

var orbit_distance: float = 30.0
var orbit_angle: float = 0.0
var orbit_height: float = 10.0
var earth_center: Vector3 = Vector3.ZERO

func _ready():
	name = \"EarthTimelineCamera\"
	fov = 75.0
	update_camera_position()

func _process(delta):
	handle_input(delta)
	update_camera_position()

func handle_input(delta):
	# Mouse orbit controls
	if Input.is_action_pressed(\"ui_left\"):
		orbit_angle += orbit_speed * delta
	if Input.is_action_pressed(\"ui_right\"):
		orbit_angle -= orbit_speed * delta
	
	if Input.is_action_pressed(\"ui_up\"):
		orbit_height += orbit_speed * 10 * delta
	if Input.is_action_pressed(\"ui_down\"):
		orbit_height -= orbit_speed * 10 * delta
	
	# Zoom controls
	if Input.is_action_just_pressed(\"zoom_in\"):
		orbit_distance = max(min_distance, orbit_distance - zoom_speed)
	if Input.is_action_just_pressed(\"zoom_out\"):
		orbit_distance = min(max_distance, orbit_distance + zoom_speed)

func update_camera_position():
	var x = earth_center.x + orbit_distance * cos(orbit_angle)
	var z = earth_center.z + orbit_distance * sin(orbit_angle)
	var y = earth_center.y + orbit_height
	
	position = Vector3(x, y, z)
	look_at(earth_center, Vector3.UP)
"

