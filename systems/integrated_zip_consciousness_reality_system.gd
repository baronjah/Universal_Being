	# Add ZIP processing overhead
	var zip_overhead = integrated_zip_realities.size() * 0.002  # 0.2% per active ZIP reality
	
	# Archaeological enhancement overhead
	var archaeological_overhead = archaeological_integration_multiplier * 0.01
	
	return base_performance + consciousness_overhead + zip_overhead + archaeological_overhead

